{
  "name": "zerogap",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "first-ratio": "tsx scripts/first-ratio.ts",
    "test": "vitest run --exclude \"**/*.live.test.ts\" --exclude \"**/*.testnet.test.ts\" --exclude \"**/node_modules/**\"",
    "test:live": "vitest run live",
    "test:testnet": "vitest run testnet",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "start": "tsx apps/server/server.ts",
    "dev": "tsx watch apps/server/server.ts",
    "flow-match": "tsx scripts/flow-match.ts",
    "worker": "tsx scripts/reserves-worker.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "pg": "^8.23.1",
    "tsx": "^4.19.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.23.1",
    "msw": "^2.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
