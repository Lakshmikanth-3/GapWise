# If empty, Cardano reads fall back to the public Koios API.
BLOCKFROST_PROJECT_ID=mainnetYOUR_KEY
DATABASE_URL=postgres://...
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STRIKE_RPS=40
