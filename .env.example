# --- Strike (public, no key needed) ---
STRIKE_API=https://api.strikefinance.org
STRIKE_TESTNET_API=https://api-v2-testnet.strikefinance.org
STRIKE_RPS=40
# Builder Connect (My Safety): your code from app.strikefinance.org/builder-codes
STRIKE_BUILDER_CODE=
STRIKE_BUILDER_FEE_BPS=0

# --- Chain RPCs (archive-capable Ethereum RPC enables full flow-match history) ---
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_LOGS_CHUNK=5000
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
BLOCKFROST_PROJECT_ID=mainnetYOUR_KEY

# --- Storage (Supabase Postgres; run packages/db/schema.sql once). Empty = local data/*.jsonl ---
DATABASE_URL=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_URL=
PUBLIC_URL=http://localhost:8787

# --- Schedules (ms) ---
RESERVES_INTERVAL_MS=60000
SAFETY_INTERVAL_MS=60000
SCAN_INTERVAL_MS=300000
FLOWS_INTERVAL_MS=1800000
FLOW_DAYS=7
PORT=8787
