# --- Strike (public, no key needed) ---
STRIKE_API=https://api.strikefinance.org
STRIKE_TESTNET_API=https://api-v2-testnet.strikefinance.org
STRIKE_RPS=40
# Builder Connect (My Safety): your code from app.strikefinance.org/builder-codes
STRIKE_BUILDER_CODE=
STRIKE_BUILDER_FEE_BPS=0

# --- Chain RPCs (archive-capable Ethereum RPC enables full flow-match history) ---
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETH_LOGS_CHUNK=5000
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
BLOCKFROST_PROJECT_ID=mainnetYOUR_KEY

# --- Storage (Supabase Postgres; run packages/db/schema.sql once). Empty = local data/*.jsonl ---
DATABASE_URL=

# --- Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_URL=
PUBLIC_URL=http://localhost:8787

# --- Schedules (ms) ---
RESERVES_INTERVAL_MS=60000
SAFETY_INTERVAL_MS=60000
SCAN_INTERVAL_MS=300000
FLOWS_INTERVAL_MS=1800000
FLOW_DAYS=7
PORT=8787

# --- GapWise Gap Investigator (AI agent; read-only). Unset = rules-only results, clearly labelled ---
# Meterless runtime (Nightshift): OpenAI-compatible endpoint on this machine. Token: the runtime's proxy-token
# (Windows %LOCALAPPDATA%\ai.meterless.runtime\proxy-token is read automatically when METERLESS_TOKEN is empty).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_TOKEN=
# Routing mode sent to the runtime; load NVIDIA Nemotron in your Nightshift fleet. GapWise reports the model the
# runtime says served the answer (response.model) and only shows "Nemotron verified" when that names Nemotron.
METERLESS_MODEL=meterless/text.deep
METERLESS_APP=gapwise
METERLESS_TIMEOUT_MS=180000
# SAMPLE_MODE=true: no Nightshift, Zetaris or RPC; investigates the bundled reports in input_examples/ (rules-only)
SAMPLE_MODE=false
# GAPWISE_AI=off forces rules-only
GAPWISE_AI=
GAPWISE_MAX_STEPS=6
# Automatic investigation after scans that are not Balanced (at most once per interval unless the gap moves)
GAPWISE_AUTO_INVESTIGATE=on
GAPWISE_AUTO_MIN_INTERVAL_MS=3600000
GAPWISE_AUTO_GAP_MOVE_USD=5000
GAPWISE_RUN_COOLDOWN_MS=60000
GAPWISE_MEMORY_DIR=data/hmem
# Set to off to skip Ethereum locker event lookups; old blocks need an archive RPC in ETH_LOGS_RPC_URL
GAPWISE_CHAIN_LOOKUPS=on
ETH_LOGS_RPC_URL=

# Zetaris (github.com/zetaris/getting-started): UI origin (no path), numeric org id, API key or username/password.
# Tables from docs/zetaris/schema.sql must exist in ZETARIS_SCHEMA on a writable data source registered in Zetaris.
ZETARIS_BASE_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=1000
ZETARIS_SCHEMA=gapwise
